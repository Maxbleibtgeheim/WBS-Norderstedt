        </mxCell>
        <mxCell id="wUH8i6BSNTHAuNKodM3G-1" value="&lt;font&gt;Im Anfangszustand ist das Zellinnere ungefähr mit -65 mV geladen, die extrazelluläre Flüssigkeit positiv. Die Ladung verändert sich nicht&lt;/font&gt;." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry y="5" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="wUH8i6BSNTHAuNKodM3G-7" value="" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;" edge="1" parent="1" source="wUH8i6BSNTHAuNKodM3G-4" target="wUH8i6BSNTHAuNKodM3G-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wUH8i6BSNTHAuNKodM3G-4" value="Ein Reiz sorgt dafür, dass sich Natriumionenkanäle öffnen. Diese werden nur bei dem Überschreiten des Aktionspotentials geöffnet." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
