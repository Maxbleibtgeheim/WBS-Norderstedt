        </mxCell>
        <mxCell id="wUH8i6BSNTHAuNKodM3G-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="wUH8i6BSNTHAuNKodM3G-6" target="wUH8i6BSNTHAuNKodM3G-8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wUH8i6BSNTHAuNKodM3G-6" value="Die soeben geöffneten Natriumkanäle bewirken ein Einströmen von Natriumionen in das Axon wo durch sich die vorliegende ladung zu einer Positiven verändert" style="whiteSpace=wrap;html=1;rounded=1;" vertex="1" parent="1">
